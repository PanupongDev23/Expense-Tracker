# --- For full production deployment with Neon database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Set to your actual domain (on Vercel this is auto-derived from VERCEL_URL if not set)
NEXTAUTH_URL="http://localhost:3000"

# --- For demo-only deployment (no database required) ---
# Set DEMO_MODE=true on Vercel to run without a database.
# Data is stored in-memory per serverless instance (resets on cold start).
DEMO_MODE="false"
